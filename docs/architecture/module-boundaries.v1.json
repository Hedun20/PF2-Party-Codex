{
  "schemaVersion": "hed18-module-boundaries-v1",
  "directionRule": "process -> adapter -> application module public port -> core/contracts",
  "jobTypes": [
    "email.deliver",
    "import.commit",
    "evidence.normalize",
    "evidence.retention",
    "canon.propose",
    "ai.author",
    "achievement.evaluate",
    "notification.deliver",
    "export.build",
    "projection.rebuild"
  ],
  "modules": [
    {
      "id": "audit",
      "ownsCollections": ["auditLogs", "securityAuditLedger"],
      "dependsOn": [],
      "commandPorts": ["recordAuditFact", "recordSecurityFact"],
      "queryPorts": ["listCampaignAuditFacts", "verifySecurityLedger"],
      "eventPorts": []
    },
    {
      "id": "jobs",
      "ownsCollections": ["jobQueue", "jobPayloads", "jobRuns", "outboxEvents"],
      "dependsOn": ["audit"],
      "commandPorts": ["enqueueJob", "cancelJob", "claimJobLease", "recordJobResult"],
      "queryPorts": ["getJobStatus", "listDeadLetterJobs"],
      "eventPorts": ["JobQueued", "JobSucceeded", "JobFailed"]
    },
    {
      "id": "identity",
      "ownsCollections": [
        "users",
        "profiles",
        "webSessions",
        "externalIdentities",
        "passwordResetTokens",
        "invitations",
        "memberships"
      ],
      "dependsOn": ["audit"],
      "commandPorts": [
        "createSession",
        "rotateSession",
        "revokeSession",
        "inviteMember",
        "changeMembership"
      ],
      "queryPorts": ["getSessionPrincipal", "getCampaignMembership", "listCampaignMembers"],
      "eventPorts": ["SessionRevoked", "MembershipChanged"]
    },
    {
      "id": "entitlements",
      "ownsCollections": ["entitlements", "subscriptions", "usageLedger"],
      "dependsOn": ["identity", "audit"],
      "commandPorts": ["changeEntitlement", "reserveUsage", "commitUsage", "releaseUsage"],
      "queryPorts": ["getWorkspaceEntitlement", "getUsageBudget"],
      "eventPorts": ["EntitlementChanged", "UsageCommitted"]
    },
    {
      "id": "campaigns",
      "ownsCollections": ["workspaces", "campaigns", "worlds"],
      "dependsOn": ["identity", "entitlements", "audit"],
      "commandPorts": ["createWorkspace", "createCampaign", "updateCampaign", "updateWorld"],
      "queryPorts": ["getCampaignContext", "getWorld", "listUserCampaigns"],
      "eventPorts": ["CampaignCreated", "CampaignChanged", "WorldChanged"]
    },
    {
      "id": "archive",
      "ownsCollections": [
        "entries",
        "entryRevisions",
        "entryRelations",
        "notes",
        "characters",
        "maps",
        "mapObjects",
        "timelineEvents",
        "sessions",
        "handouts",
        "assets"
      ],
      "dependsOn": ["identity", "campaigns", "jobs", "audit"],
      "commandPorts": [
        "createArchiveEntry",
        "reviseArchiveEntry",
        "approveCanonRevision",
        "rebuildEntryRelations",
        "publishReveal"
      ],
      "queryPorts": [
        "getArchiveEntry",
        "listArchiveEntries",
        "searchArchive",
        "getCampaignArchiveSummary"
      ],
      "eventPorts": ["CanonRevisionApproved", "ArchiveProjectionChanged", "RevealPublished"]
    },
    {
      "id": "evidence",
      "ownsCollections": ["evidenceRecords", "characterKnowledgeGrants"],
      "dependsOn": ["identity", "campaigns", "jobs", "audit"],
      "commandPorts": [
        "appendEvidenceOccurrence",
        "changeEvidenceRetention",
        "grantCharacterKnowledge",
        "deleteExpiredEvidence"
      ],
      "queryPorts": ["searchEvidence", "getEvidenceForReview", "getCharacterKnowledge"],
      "eventPorts": ["EvidenceAccepted", "EvidenceExpired", "CharacterKnowledgeChanged"]
    },
    {
      "id": "integrations",
      "ownsCollections": [
        "integrationConnections",
        "connectorPairings",
        "connectorCredentials",
        "serviceCredentials",
        "ingestionCursors",
        "ingestionReceipts",
        "importJobs"
      ],
      "dependsOn": ["identity", "campaigns", "evidence", "jobs", "audit"],
      "commandPorts": [
        "createPairing",
        "exchangePairing",
        "revokeConnection",
        "acceptEventBatch",
        "advanceIngestionCursor"
      ],
      "queryPorts": ["getConnectionHealth", "getIngestionCursor", "getIngestionReceipt"],
      "eventPorts": ["ConnectionChanged", "EventBatchAccepted", "IngestionGapDetected"]
    },
    {
      "id": "ai",
      "ownsCollections": ["authoringRequests", "authoringRuns", "canonProposals"],
      "dependsOn": ["campaigns", "archive", "evidence", "entitlements", "jobs", "audit"],
      "commandPorts": ["requestAuthoring", "cancelAuthoring", "submitCanonProposal"],
      "queryPorts": ["getAuthoringRun", "getCanonProposal"],
      "eventPorts": ["AuthoringCompleted", "CanonProposalSubmitted"]
    },
    {
      "id": "achievements",
      "ownsCollections": ["achievementDefinitions", "achievementAwards"],
      "dependsOn": ["campaigns", "evidence", "jobs", "audit"],
      "commandPorts": ["defineAchievement", "evaluateAchievement", "revokeAchievementAward"],
      "queryPorts": ["listManagerAchievements", "listSubjectAchievements"],
      "eventPorts": ["AchievementAwarded", "AchievementRevoked"]
    },
    {
      "id": "notifications",
      "ownsCollections": ["notificationOutbox", "notificationDeliveries", "emailOutbox"],
      "dependsOn": ["identity", "campaigns", "archive", "jobs", "audit"],
      "commandPorts": ["enqueueNotification", "cancelNotification", "recordDeliveryResult"],
      "queryPorts": ["getNotificationDelivery", "getNotificationReadiness"],
      "eventPorts": ["NotificationQueued", "NotificationDelivered", "NotificationFailed"]
    },
    {
      "id": "operations",
      "ownsCollections": ["migrationRuns", "migrationItems", "migrationReports", "indexManifests"],
      "dependsOn": [
        "identity",
        "jobs",
        "entitlements",
        "campaigns",
        "archive",
        "evidence",
        "integrations",
        "ai",
        "achievements",
        "notifications",
        "audit"
      ],
      "commandPorts": [
        "inventoryMigration",
        "dryRunMigration",
        "commitMigration",
        "verifyMigration",
        "rollbackMigrationRouting",
        "applyIndexManifest"
      ],
      "queryPorts": ["getMigrationReport", "verifyIndexManifest"],
      "eventPorts": ["MigrationCommitted", "MigrationRoutingRolledBack", "IndexManifestApplied"]
    },
    {
      "id": "workflows",
      "ownsCollections": [],
      "dependsOn": [
        "identity",
        "jobs",
        "entitlements",
        "campaigns",
        "archive",
        "evidence",
        "integrations",
        "ai",
        "achievements",
        "notifications",
        "audit"
      ],
      "commandPorts": ["onboardWorkspaceCampaign", "deleteCampaignSafely", "exportCampaignSafely"],
      "queryPorts": ["getCampaignPortalView"],
      "eventPorts": []
    }
  ],
  "processes": [
    {
      "id": "web-next",
      "inbound": "browser-http",
      "mongoAccess": "through-owned-adapters",
      "ownsQueueLeases": false,
      "invokesPorts": [
        "identity.createSession",
        "identity.rotateSession",
        "identity.revokeSession",
        "identity.inviteMember",
        "identity.changeMembership",
        "identity.getSessionPrincipal",
        "identity.getCampaignMembership",
        "identity.listCampaignMembers",
        "jobs.enqueueJob",
        "jobs.cancelJob",
        "jobs.getJobStatus",
        "entitlements.changeEntitlement",
        "entitlements.reserveUsage",
        "entitlements.commitUsage",
        "entitlements.releaseUsage",
        "entitlements.getWorkspaceEntitlement",
        "entitlements.getUsageBudget",
        "campaigns.createWorkspace",
        "campaigns.createCampaign",
        "campaigns.updateCampaign",
        "campaigns.updateWorld",
        "campaigns.getCampaignContext",
        "campaigns.getWorld",
        "campaigns.listUserCampaigns",
        "archive.createArchiveEntry",
        "archive.reviseArchiveEntry",
        "archive.approveCanonRevision",
        "archive.rebuildEntryRelations",
        "archive.publishReveal",
        "archive.getArchiveEntry",
        "archive.listArchiveEntries",
        "archive.searchArchive",
        "archive.getCampaignArchiveSummary",
        "evidence.appendEvidenceOccurrence",
        "evidence.changeEvidenceRetention",
        "evidence.grantCharacterKnowledge",
        "evidence.deleteExpiredEvidence",
        "evidence.searchEvidence",
        "evidence.getEvidenceForReview",
        "evidence.getCharacterKnowledge",
        "integrations.createPairing",
        "integrations.exchangePairing",
        "integrations.revokeConnection",
        "integrations.acceptEventBatch",
        "integrations.advanceIngestionCursor",
        "integrations.getConnectionHealth",
        "integrations.getIngestionCursor",
        "integrations.getIngestionReceipt",
        "ai.requestAuthoring",
        "ai.cancelAuthoring",
        "ai.submitCanonProposal",
        "ai.getAuthoringRun",
        "ai.getCanonProposal",
        "achievements.defineAchievement",
        "achievements.evaluateAchievement",
        "achievements.revokeAchievementAward",
        "achievements.listManagerAchievements",
        "achievements.listSubjectAchievements",
        "notifications.enqueueNotification",
        "notifications.cancelNotification",
        "notifications.recordDeliveryResult",
        "notifications.getNotificationDelivery",
        "notifications.getNotificationReadiness",
        "workflows.onboardWorkspaceCampaign",
        "workflows.deleteCampaignSafely",
        "workflows.exportCampaignSafely",
        "workflows.getCampaignPortalView"
      ]
    },
    {
      "id": "legacy-api",
      "inbound": "compatibility-http",
      "mongoAccess": "through-owned-adapters",
      "ownsQueueLeases": false,
      "invokesPorts": [
        "identity.createSession",
        "identity.rotateSession",
        "identity.revokeSession",
        "identity.inviteMember",
        "identity.changeMembership",
        "identity.getSessionPrincipal",
        "identity.getCampaignMembership",
        "identity.listCampaignMembers",
        "jobs.enqueueJob",
        "jobs.cancelJob",
        "jobs.getJobStatus",
        "campaigns.createWorkspace",
        "campaigns.createCampaign",
        "campaigns.updateCampaign",
        "campaigns.updateWorld",
        "campaigns.getCampaignContext",
        "campaigns.getWorld",
        "campaigns.listUserCampaigns",
        "archive.createArchiveEntry",
        "archive.reviseArchiveEntry",
        "archive.approveCanonRevision",
        "archive.rebuildEntryRelations",
        "archive.publishReveal",
        "archive.getArchiveEntry",
        "archive.listArchiveEntries",
        "archive.searchArchive",
        "archive.getCampaignArchiveSummary",
        "integrations.createPairing",
        "integrations.exchangePairing",
        "integrations.revokeConnection",
        "integrations.acceptEventBatch",
        "integrations.advanceIngestionCursor",
        "integrations.getConnectionHealth",
        "integrations.getIngestionCursor",
        "integrations.getIngestionReceipt",
        "notifications.enqueueNotification",
        "notifications.cancelNotification",
        "notifications.recordDeliveryResult",
        "notifications.getNotificationDelivery",
        "notifications.getNotificationReadiness"
      ]
    },
    {
      "id": "worker",
      "inbound": "queue-lease",
      "mongoAccess": "through-owned-adapters",
      "ownsQueueLeases": true,
      "invokesPorts": [
        "entitlements.reserveUsage",
        "entitlements.commitUsage",
        "entitlements.releaseUsage",
        "entitlements.getWorkspaceEntitlement",
        "entitlements.getUsageBudget",
        "jobs.enqueueJob",
        "jobs.claimJobLease",
        "jobs.recordJobResult",
        "jobs.getJobStatus",
        "jobs.listDeadLetterJobs",
        "archive.createArchiveEntry",
        "archive.reviseArchiveEntry",
        "archive.approveCanonRevision",
        "archive.rebuildEntryRelations",
        "archive.publishReveal",
        "archive.getArchiveEntry",
        "archive.listArchiveEntries",
        "archive.searchArchive",
        "archive.getCampaignArchiveSummary",
        "evidence.appendEvidenceOccurrence",
        "evidence.changeEvidenceRetention",
        "evidence.grantCharacterKnowledge",
        "evidence.deleteExpiredEvidence",
        "evidence.searchEvidence",
        "evidence.getEvidenceForReview",
        "evidence.getCharacterKnowledge",
        "integrations.createPairing",
        "integrations.exchangePairing",
        "integrations.revokeConnection",
        "integrations.acceptEventBatch",
        "integrations.advanceIngestionCursor",
        "integrations.getConnectionHealth",
        "integrations.getIngestionCursor",
        "integrations.getIngestionReceipt",
        "ai.requestAuthoring",
        "ai.cancelAuthoring",
        "ai.submitCanonProposal",
        "ai.getAuthoringRun",
        "ai.getCanonProposal",
        "achievements.defineAchievement",
        "achievements.evaluateAchievement",
        "achievements.revokeAchievementAward",
        "achievements.listManagerAchievements",
        "achievements.listSubjectAchievements",
        "notifications.enqueueNotification",
        "notifications.cancelNotification",
        "notifications.recordDeliveryResult",
        "notifications.getNotificationDelivery",
        "notifications.getNotificationReadiness",
        "audit.recordAuditFact",
        "audit.recordSecurityFact",
        "audit.listCampaignAuditFacts",
        "audit.verifySecurityLedger"
      ]
    },
    {
      "id": "discord-bot",
      "inbound": "discord-gateway",
      "mongoAccess": "none",
      "ownsQueueLeases": false,
      "invokesPorts": []
    },
    {
      "id": "foundry-module",
      "inbound": "foundry-hooks",
      "mongoAccess": "none",
      "ownsQueueLeases": false,
      "invokesPorts": []
    },
    {
      "id": "migration-command",
      "inbound": "operator-command",
      "mongoAccess": "through-approved-operator-adapters",
      "ownsQueueLeases": false,
      "invokesPorts": [
        "operations.inventoryMigration",
        "operations.dryRunMigration",
        "operations.commitMigration",
        "operations.verifyMigration",
        "operations.rollbackMigrationRouting",
        "operations.getMigrationReport"
      ]
    },
    {
      "id": "index-command",
      "inbound": "operator-command",
      "mongoAccess": "through-approved-operator-adapters",
      "ownsQueueLeases": false,
      "invokesPorts": [
        "operations.applyIndexManifest",
        "operations.verifyIndexManifest"
      ]
    }
  ]
}
